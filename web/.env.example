# ── ปลายทางของ lead (จำเป็นสำหรับ production) ────────────────────────────────
# บน Vercel ระบบไฟล์เป็น read-only เขียน data/leads.json ไม่ได้ ถ้าไม่ตั้งค่านี้
# ฟอร์มจะตอบ 503 และบอกลูกค้าให้โทร/แอดไลน์แทน (ดีกว่าเงียบแล้วข้อมูลหาย)
#
# ใส่ URL ที่รับ POST เป็น JSON ได้ ใช้ได้กับ:
#   - n8n Webhook node
#   - Google Apps Script (doPost แล้วเขียนลง Google Sheet)
#   - Make / Zapier / endpoint ของทีมเอง
#
# payload ที่ยิงไปคือ:
#   { id, name, phone, company, contact, jobType, area, hours, detail,
#     source, receivedAt }
#
# ต้องไปตั้งใน Vercel ด้วย: Project Settings > Environment Variables
LEAD_WEBHOOK_URL=

# ── อีเมลแจ้งเตือน lead (Resend) ─────────────────────────────────────────────
# ที่เก็บ lead ถาวรคือตาราง leads ใน Supabase (migration 0004) ส่วนเมลเป็นตัวปลุก
# ทีมขาย ถ้าไม่ตั้ง RESEND_API_KEY ฟอร์มยังทำงานได้ปกติ แค่ไม่มีเมลแจ้ง
#
# RESEND_API_KEY  หาได้ที่ resend.com/api-keys
# LEAD_EMAIL_TO   ผู้รับ คั่นด้วย , ได้หลายคน (ค่าปริยาย imatthailand@gmail.com)
# LEAD_EMAIL_FROM ต้องเป็นโดเมนที่ verify แล้วใน Resend เท่านั้น
#                 ยังไม่ verify ให้เว้นว่าง โค้ดจะใช้ onboarding@resend.dev ซึ่ง
#                 ส่งได้เฉพาะเข้าอีเมลเจ้าของบัญชี Resend
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=

# ── token สำหรับดึงรายการ lead (ไม่บังคับ) ───────────────────────────────────
# GET /api/quote เก็บชื่อและเบอร์ลูกค้าซึ่งเป็นข้อมูลส่วนบุคคล จึงต้องมี token
# ถ้าเว้นว่างไว้ endpoint จะตอบ 404 ทุกกรณี (ปลอดภัยที่สุด)
#
# วิธีเรียกเมื่อตั้งค่าแล้ว:
#   curl -H "Authorization: Bearer <token>" https://<โดเมน>/api/quote
#
# สร้าง token สุ่ม: openssl rand -hex 32
LEADS_ADMIN_TOKEN=

# ── ระบบหลังบ้าน (Supabase) ──────────────────────────────────────────────────
# ถ้าเว้นว่างทั้งสองค่า เว็บหน้าบ้านทำงานปกติทุกหน้า ส่วน /admin จะขึ้นวิธีตั้งค่าให้แทน
# หาได้ที่ Supabase → Project Settings → API
#
# ขั้นตอนตั้งค่าครั้งแรกอยู่ที่ docs/cms-setup.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
